<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Wi-Fi locks need it -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- Sony HW 정지영상 디코더(OptimizedImageFactory.decodeImage). 선언 안 하면 네이티브/타입이 안 붙어 null 반환.
             sony.cameraex = OptimizedImage/DeviceMemory 타입, stillPlay = 디코더 래퍼, database_library = avindex. (grain-lab 검증) -->
        <uses-library android:name="sony.cameraex" android:required="false" />
        <uses-library android:name="com.sony.scalar.stillPlay" android:required="false" />
        <uses-library android:name="com.sony.scalar.database_library" android:required="false" />
        <receiver
            android:name=".ExitCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.server.DAConnectionManagerService.ExitCompleted" />
                <category android:name="ANDROID.INTENT.CATEGORY.DEFAULT" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
