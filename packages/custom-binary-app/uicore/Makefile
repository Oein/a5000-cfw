# libuicore — platform-agnostic UI core. Produces build/$(TARGET)/libuicore.a.
#   make TARGET=host | ndk | cross
NATIVE := ..
include common.mk

OUT    := build/$(TARGET)
OBJDIR := $(OUT)/obj
SRCS   := src/action.cpp src/keymap.cpp src/keymap_shoot.cpp src/log.cpp src/canvas.cpp src/app.cpp src/screen_test.cpp src/gfx/assets_loader.cpp src/gfx/gfx.cpp \
        src/model/catalog.cpp src/model/catalog_gen.cpp src/model/camera_model.cpp src/ui/screens/shooting_osd.cpp src/ui/screens/menu_cascade.cpp src/ui/screens/key_config.cpp src/ui/screens/playback.cpp src/ui/screens/wifi.cpp src/ui/screens/nfc.cpp src/ui/screens/menu_actions.cpp src/ui/widgets/text_input.cpp src/model/menu_gen.cpp src/model/apply.cpp src/model/apply_gen.cpp
OBJS   := $(patsubst src/%.cpp,$(OBJDIR)/%.o,$(SRCS))
LIB    := $(OUT)/libuicore.a

.PHONY: all clean
all: $(LIB)
	@echo "built $(LIB)"

$(OBJDIR)/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

$(LIB): $(OBJS)
	@mkdir -p $(OUT)
	$(AR) rcs $@ $(OBJS)

# header-dependency tracking (-MMD): rebuild .o when an included header changes
-include $(OBJS:.o=.d)

clean:   # never wipe build/assets (firmware-derived atlases, regenerated by tools/)
	rm -rf build/host build/ndk build/cross
